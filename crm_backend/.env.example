SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rarity_crm
CORS_ALLOWED_ORIGINS=http://localhost:3000
CRM_BASE_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8010
# shared secret the raritydental.com server sends as X-Rarity-Key
CRM_INTAKE_API_KEY=generate-a-long-random-string
CRM_MANAGER_EMAIL=
RESEND_API_KEY=
CRM_FROM_EMAIL=Rarity CRM <onboarding@raritydental.com>

# Google Calendar (service account)
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_DEFAULT_CALENDAR_ID=
# Twilio calling
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_RECORD_CALLS=false

# Quote letterhead
CLINIC_NAME=Rarity Dental
CLINIC_ADDRESS=
CLINIC_PHONE=
CLINIC_EMAIL=
CLINIC_WEBSITE=www.raritydental.com
CLINIC_TAX_ID=
QUOTE_VALID_DAYS=30

# --- Production (Render) -----------------------------------------------------------------
# On Render you set these in the dashboard / render.yaml, NOT in a committed file:
#   DEBUG=False                      (anything else weakens security; the app refuses to start with a weak SECRET_KEY)
#   SECRET_KEY=<generated by Render>
#   DATABASE_URL=<Neon pooled string>
#   CRM_INTAKE_API_KEY=<long random, same as the website>   CRM_BASE_URL=<Netlify URL>
# PUBLIC_BASE_URL and ALLOWED_HOSTS default from Render's own URL. Tuning: DB_CONN_MAX_AGE, WEB_CONCURRENCY, Q_WORKERS, Q_POLL.
